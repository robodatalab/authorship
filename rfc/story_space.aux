\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Illustration, not computed from data: the first two relations on transformed points. Each dot is the point of one token in the adapted space; $z_1$ and $z_2$ are two of its dimensions. A text's volume is the smallest polygon around its tokens' points. Filled areas: texts alone. Dashed outlines and hollow circles: joined texts, whose points are the points of their parts. Hatched: the overlap of the two dashed volumes, the left side of the relation. Left: $V(A) \cap V(D) = \emptyset $; A's and D's volumes do not meet. Right: $V(A + B) \cap V(D + B) = V(B)$; A + B and D + B overlap exactly in B's volume.}}{10}{}\protected@file@percent }
\newlabel{fig:overlap-1}{{5}{10}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Illustration, not computed from data: the last two relations on transformed points, drawn as in Figure~\ref {fig:overlap-1}. B and E overlap. Left: $V(A + B) \cap V(D + E) = V(B) \cap V(E)$; A + B and D + E overlap exactly where B and E do. Right: $V(A + E) \cap V(D + B) = V(B) \cap V(E)$; so do A + E and D + B.}}{11}{}\protected@file@percent }
\newlabel{fig:overlap-2}{{6}{11}{}{figure.6}{}}
