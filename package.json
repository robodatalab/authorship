{
    "name": "authorship",
    "displayName": "Authorship",
    "description": "Tools for creative writing",
    "version": "0.0.9",
    "publisher": "RoboDataLab",
    "repository": {
        "type": "git",
        "url": "https://github.com/robodatalab/writer.git"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "icon": "media/icon.png",
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "markdown",
                "extensions": [
                    ".author"
                ]
            }
        ],
        "icons": {
            "authorship-import-markdown": {
                "description": "Import a markdown manuscript",
                "default": {
                    "fontPath": "media/authorship-icons.woff",
                    "fontCharacter": "\\E001"
                }
            },
            "authorship-export-markdown": {
                "description": "Export as one markdown manuscript",
                "default": {
                    "fontPath": "media/authorship-icons.woff",
                    "fontCharacter": "\\E002"
                }
            },
            "authorship-export-epub": {
                "description": "Export as an EPUB",
                "default": {
                    "fontPath": "media/authorship-icons.woff",
                    "fontCharacter": "\\E003"
                }
            },
            "authorship-export-parts": {
                "description": "Export as markdown parts",
                "default": {
                    "fontPath": "media/authorship-icons.woff",
                    "fontCharacter": "\\E004"
                }
            }
        },
        "customEditors": [
            {
                "viewType": "authorship.authorEditor",
                "displayName": "Author",
                "selector": [
                    {
                        "filenamePattern": "*.author"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "authorship.author.runAll",
                "title": "Run All",
                "category": "Authorship",
                "icon": "$(run-all)"
            },
            {
                "command": "authorship.author.importMarkdown",
                "title": "Import Markdown",
                "category": "Authorship",
                "icon": "$(authorship-import-markdown)"
            },
            {
                "command": "authorship.author.exportMarkdown",
                "title": "Export Markdown",
                "category": "Authorship",
                "icon": "$(authorship-export-markdown)"
            },
            {
                "command": "authorship.author.exportEpub",
                "title": "Export EPUB",
                "category": "Authorship",
                "icon": "$(authorship-export-epub)"
            },
            {
                "command": "authorship.author.partition",
                "title": "Divide into Parts",
                "category": "Authorship",
                "icon": "$(authorship-export-parts)"
            },
            {
                "command": "authorship.author.fixStyle",
                "title": "Fix Style and Grammar",
                "category": "Authorship",
                "icon": "$(sparkle)"
            },
            {
                "command": "authorship.author.viewSource",
                "title": "View Source",
                "category": "Authorship",
                "icon": "$(file-code)"
            },
            {
                "command": "authorship.gemini.signIn",
                "title": "Sign in to Gemini",
                "category": "Authorship"
            },
            {
                "command": "authorship.gemini.signOut",
                "title": "Sign out of Gemini",
                "category": "Authorship"
            },
            {
                "command": "authorship.gemini.chooseModel",
                "title": "Choose Gemini Model",
                "category": "Authorship"
            }
        ],
        "configuration": [
            {
                "title": "Experimental",
                "order": 1,
                "properties": {
                    "authorship.experimental.useGeminiForStyleCorrection": {
                        "type": "boolean",
                        "default": false,
                        "order": 1,
                        "tags": [
                            "experimental"
                        ],
                        "markdownDescription": "Correct the style and grammar of a whole manuscript with Google Gemini.\n\n**This is the one feature in Authorship that does not run on your machine.** It sends the chapters of the document it is run on to the Gemini API, on your own API key, and is billed to that account. Everything else Authorship does is local.\n\nOff, the tool is hidden and nothing is ever sent. On, a sparkle appears in the `.author` toolbar and a Gemini account appears in the Authorship sidebar.",
                        "scope": "window"
                    },
                    "authorship.gemini.model": {
                        "type": "string",
                        "default": "",
                        "order": 2,
                        "tags": [
                            "experimental"
                        ],
                        "markdownDescription": "Which Gemini model fixes style and grammar. Left empty, Authorship uses the one it ships with. Google retires model names from time to time; when a pass fails with *no longer available*, the error names its replacement — put that name here.\n\nThe **Account** drawer in the Authorship sidebar lists the models your key can actually reach.",
                        "scope": "window"
                    }
                }
            }
        ],
        "authentication": [
            {
                "id": "gemini",
                "label": "Google Gemini"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "authorship",
                    "title": "Authorship",
                    "icon": "./media/icon.svg"
                }
            ]
        },
        "views": {
            "authorship": [
                {
                    "id": "authorship.manuscript",
                    "name": "Manuscript",
                    "type": "webview",
                    "icon": "./media/icon.svg"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "clean": "rm -rf dist out",
        "rebuild": "npm run clean && npm run compile",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "lint": "eslint extension tests/extension",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/vscode": "^1.125.0",
        "@vscode/codicons": "^0.0.46-24",
        "css-loader": "^7.1.5",
        "eslint": "^10.5.0",
        "happy-dom": "^20.11.2",
        "mini-css-extract-plugin": "^2.10.2",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vitest": "^3.2.4",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.3"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "marked": "^18.0.11",
        "monaco-editor": "^0.56.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "yaml": "^2.9.0"
    }
}
