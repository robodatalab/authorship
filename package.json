{
  "name": "authorship",
  "displayName": "Authorship",
  "description": "Tools for creative writing",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "authorship.fixGrammar",
        "title": "Fix Grammar",
        "category": "Authorship",
        "icon": "$(wand)"
      },
      {
        "command": "authorship.searchManuscript",
        "title": "Search Manuscript",
        "category": "Authorship",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "authorship.fixGrammar",
          "when": "resourceExtname == .md",
          "group": "navigation@1"
        },
        {
          "command": "authorship.searchManuscript",
          "when": "resourceExtname == .md",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "authorship",
          "title": "Authorship",
          "icon": "./media/icon.svg"
        }
      ]
    },
    "views": {
      "authorship": [
        {
          "id": "authorship.manuscript",
          "name": "Manuscript",
          "type": "webview",
          "icon": "./media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "clean": "rm -rf dist out",
    "rebuild": "npm run clean && npm run compile",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint extension tests/extension",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^3.2.4",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
