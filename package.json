{
    "name": "authorship",
    "displayName": "Authorship",
    "description": "Tools for creative writing",
    "version": "0.1.10",
    "publisher": "RoboDataLab",
    "repository": {
        "type": "git",
        "url": "https://github.com/robodatalab/writer.git"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "icon": "media/icon.png",
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "markdown",
                "extensions": [
                    ".author"
                ]
            }
        ],
        "customEditors": [
            {
                "viewType": "authorship.authorEditor",
                "displayName": "Author",
                "selector": [
                    {
                        "filenamePattern": "*.author"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [],
        "configuration": [
            {
                "title": "Model server",
                "order": 0,
                "properties": {
                    "authorship.modelServerPort": {
                        "type": "number",
                        "default": 8765,
                        "scope": "window",
                        "markdownDescription": "The port the model server listens on. Every window that finds a server already answering there uses it rather than starting a second one, so one server serves them all. Give a window a port of its own \u2014 or set `AUTHORSHIP_MODEL_SERVER_PORT` in a launch configuration \u2014 when it should start and own a server nobody else shares."
                    }
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "authorship",
                    "title": "Authorship",
                    "icon": "./media/icon.svg"
                }
            ]
        },
        "views": {
            "authorship": [
                {
                    "id": "authorship.manuscript",
                    "name": "Manuscript",
                    "type": "webview",
                    "icon": "./media/icon.svg"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "clean": "rm -rf dist out",
        "rebuild": "npm run clean && npm run compile",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "lint": "eslint extension tests/extension",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/vscode": "^1.125.0",
        "@vscode/codicons": "^0.0.46-24",
        "css-loader": "^7.1.5",
        "eslint": "^10.5.0",
        "happy-dom": "^20.11.2",
        "mini-css-extract-plugin": "^2.10.2",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vitest": "^3.2.4",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.3"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "marked": "^18.0.11",
        "monaco-editor": "^0.56.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "yaml": "^2.9.0"
    }
}
