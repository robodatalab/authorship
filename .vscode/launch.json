// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			// The extension alone, with no Python behind it. `ModelServer` refuses
			// to spawn a server in a development host — it would take the port
			// from the one under the debugger, and the breakpoints with it — so
			// this configuration leaves the status bar reading `offline` and every
			// tool that needs a model doing nothing. Named for what it does not
			// start, because chosen by accident it looks like a broken extension.
			// "Extension + Server", at the bottom of the dropdown, is the one to run.
			"name": "Extension only (no model server)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			// Named outright rather than reached through ${defaultBuildTask}. The
			// indirection is how this came to depend on a watcher nobody had
			// looked at: what the launch builds with should be readable here.
			"preLaunchTask": "rebuild"
		},
		{
			// Breakpoints in server/*.py work here. The port is fixed rather than
			// ephemeral so the extension knows where to find a server it did not
			// start itself.
			"name": "Story Model Server",
			"type": "debugpy",
			"request": "launch",
			"module": "server",
			"args": [
				"--port",
				"8765"
			],
			"python": "${workspaceFolder}/.venv/bin/python",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"justMyCode": true,
			"preLaunchTask": "uv sync"
		}
	],
	"compounds": [
		{
			"name": "Extension + Server",
			"configurations": [
				"Extension only (no model server)",
				"Story Model Server"
			],
			"stopAll": true
		}
	]
}
